<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a archivos sensibles y de configuración
    <FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md">
        Require all denied
    </FilesMatch>

    # Redirigir todo el tráfico a la carpeta public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
